<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModernTIX</AssemblyName>
    <RootNamespace>TixClock</RootNamespace>
    <ApplicationIcon>TixClock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Keep the product version a plain 1.0.0 rather than appending the Git commit -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Modern TIX</Product>
    <!-- Shown as the app's name in Task Manager -->
    <AssemblyTitle>Modern TIX</AssemblyTitle>
    <Authors>Ben Somner</Authors>
    <Copyright>Copyright © 2026 Ben Somner</Copyright>
    <Description>A modern Windows take on the TIX LED clock</Description>
    <!-- WPF Fluent theme and WinForms colour mode are flagged experimental; WFO0003 is a WinForms-only DPI hint
         that doesn't apply here, as WPF reads its DPI awareness from the manifest -->
    <NoWarn>$(NoWarn);WPF0001;WFO5001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and colour picker; keep its types out of the global namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="TixClock.ico" />
  </ItemGroup>

</Project>
